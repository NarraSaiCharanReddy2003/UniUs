# Get your free API key from https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here

# Model options: llama-3.3-70b-versatile, mixtral-8x7b-32768, llama3-8b-8192
GROQ_MODEL=llama-3.3-70b-versatile

# Generation settings
MAX_TOKENS=1024
TEMPERATURE=0.7

# Flask settings
FLASK_DEBUG=True
PORT=5000
